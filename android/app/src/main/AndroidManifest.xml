<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Pentest V-16: the `camera` plugin's own manifest declares
         RECORD_AUDIO unconditionally (for its video-recording API), even
         though this app only ever opens the controller with
         enableAudio: false (in_app_camera_screen.dart) — it captures still
         photos of the collector, cheque and Emirates ID only, never video or
         audio. tools:node="remove" strips the merged permission from the
         final manifest instead of just leaving it unrequested at runtime, so
         it doesn't show up in the Play Store's permission list either. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <application
        android:label="Sobha Cheque Tracker"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <!-- Flutter's own app template declares android:taskAffinity="" on
             this activity; it is deliberately absent here. flutter_appauth's
             README lists removing it as the fix for its single documented
             Android symptom - "if authorization doesn't return to your app
             despite correct configuration". With an empty task affinity
             MainActivity gets a task of its own, so the redirect that the
             browser hands to AppAuth's RedirectUriReceiverActivity isn't
             reliably delivered back into the task holding the Flutter engine
             that is waiting on it, and AzureAdSsoService.signIn()'s future
             never completes (it ends on the timeout instead). Put it back
             only if the template's task behaviour ever matters more than
             Microsoft SSO working. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Pentest V-06: flutter_appauth's own manifest contributes an
             intent-filter on this activity for the custom scheme configured
             via the appAuthRedirectScheme placeholder in build.gradle.kts
             (com.sobha.chequetracker://oauthredirect). Custom schemes are
             not exclusive on Android — any app can register the same one
             and intercept the redirect — so these additional intent-filters
             add verified HTTPS Android App Links as OS-enforced redirect
             targets. Android's manifest merger combines all filters onto the
             one activity since the component name matches.

             One filter for the single active environment's host, not one
             filter per environment (previously dev/uat/prod all at once):
             this app has no Gradle product flavors, so build.gradle.kts
             resolves the oauthRedirectHost placeholder below from the same
             APP_ENV dart-define the Dart side already reads (see
             resolveOauthRedirectHost() there) and the manifest merger bakes
             in only that one host. A static/decompiled read of a built APK's
             manifest — exactly how pentest V-14 found all three hosts listed
             together — now shows only the environment that APK was actually
             built for.

             This filter is inert until, for the active host: the API/infra
             team publishes a Digital Asset Links file at
             https://<host>/.well-known/assetlinks.json (see
             android/app/assetlinks.json.template for its contents and how to
             get the signing-certificate fingerprint it needs), and that same
             https://<host>/oauthredirect URL is registered as a redirect URI
             on the Entra ID app registration alongside the existing custom
             scheme. Until then, AzureAdConfig.redirectUri / .env must keep
             using the custom scheme as the active redirectUri: without a
             live, correct assetlinks.json, android:autoVerify fails and the
             OS falls back to the disambiguation chooser instead of routing
             straight to the app. -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="${oauthRedirectHost}"
                    android:pathPrefix="/oauthredirect"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- ML Kit Text Recognition: fetch the on-device OCR model at
             install/update time via Play Store, instead of lazily on first
             scan — avoids a first-use download stalling on a slow/filtered
             network. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
